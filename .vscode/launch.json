{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/BuoyancyAircraft.Samples/bin/Debug/net10.0/BuoyancyAircraft.Samples.dll",
            "args": [
                "SSGBarrierSamples2",
                "-n=3",
                "-d=6",
                "-s=3",
                "--method=SSGDE",
                "--case=Case3",
            ],
            "cwd": "${workspaceFolder}/BuoyancyAircraft.Samples",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}